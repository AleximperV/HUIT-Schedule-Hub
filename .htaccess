Options -Indexes

<FilesMatch "^(\.env|\.env\.example|composer\.json|composer\.lock|\.gitignore|README\.md|LICENSE)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(src|database|vendor|pages|\.github)/ - [F,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
